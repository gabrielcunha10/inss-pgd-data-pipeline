                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "O monitoramento do Programa de Gestão e Desempenho (PGD) concilia o princípio da publicidade administrativa (Lei de Acesso à Informação nº 12.527/2011) com as diretrizes do ",
                    "textStyle": {
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  },
                  {
                    "value": "Art. 13 da Lei Geral de Proteção de Dados (Lei nº 13.709/2018)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  },
                  {
                    "value": ", voltado à avaliação de políticas públicas com salvaguardas de anonimização.",
                    "textStyle": {
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Pseudonimização Irreversível (HMAC-SHA256)",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "9pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "As matrículas Siape e identificadores de pessoal são descaracterizados na origem através de algoritmo criptográfico com chave secreta segregada (",
                    "textStyle": {
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  },
                  {
                    "value": "HMAC_SECRET_KEY",
                    "textStyle": {
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontStyle": "italic",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  },
                  {
                    "value": ") na camada de ETL em Python. O identificador resultante (",
                    "textStyle": {
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  },
                  {
                    "value": "USR-XXXXXXXX",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, Liberation Mono, Courier New, monospace",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  },
                  {
                    "value": ") inviabiliza a reidentificação direta por usuários externos.",
                    "textStyle": {
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Princípio de Minimização e Privacy by Design",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "9pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Nenhum dado pessoal sensível (nome civil ou matrícula original) trafega no banco de dados em nuvem ou no arquivo deste relatório. A modelagem opera exclusivamente sobre métricas institucionais e agregadas.",
                    "textStyle": {
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  }
                ],
                "listType": "bullet"
              },
              {
                "textRuns": [
                  {
                    "value": "Auditoria Automatizada Contínua",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "9pt",
                      "color": "#334155"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A integridade das máscaras criptográficas é validada a cada sincronização por testes automatizados (",
                    "textStyle": {
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  },
                  {
                    "value": "pytest",
                    "textStyle": {
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontStyle": "italic",
                      "fontSize": "8pt",
                      "color": "#334155"
                    }
                  },
                  {
                    "value": ") no fluxo de CI/CD do GitHub Actions, garantindo que nenhum registro fora do padrão seja publicado.",
                    "textStyle": {
                      "fontFamily": "Segoe WPC, Segoe UI, sans-serif",
                      "fontSize": "8pt",
