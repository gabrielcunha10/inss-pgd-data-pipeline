				    #"Tipo Alterado" = Table.TransformColumnTypes(#"Cabeçalhos Promovidos",{{"competencia", type date}, {"competencia_mes_ano", type date}, {"servidores_plano_ativo", Int64.Type}, {"servidores_plano_ativo_fmt", Int64.Type}, {"variacao_mensal_mom", Int64.Type}, {"variacao_mensal_mom_fmt", Percentage.Type}, {"adesao_teletrabalho_pct", Int64.Type}, {"adesao_teletrabalho_fmt", Percentage.Type}, {"adesao_remoto_pct", Int64.Type}, {"adesao_remoto_fmt", Percentage.Type}, {"motor_analise_ia", type text}, {"diagnostico_executivo", type text}, {"principais_movimentacoes_mom", type text}, {"matriz_alertas_recomendacoes", type text}})
				in
