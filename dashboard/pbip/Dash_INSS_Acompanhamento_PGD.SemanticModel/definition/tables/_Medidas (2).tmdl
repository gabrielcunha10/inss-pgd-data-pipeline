	measure Cor_Card1_Servidores_Ativos = ```
			
			VAR CompAtual = SELECTEDVALUE(insights_historico_powerbi[competencia])
			VAR CompAnterior = 
			    CALCULATE(
			        MAX(insights_historico_powerbi[competencia]),
			        ALL(insights_historico_powerbi),
			        insights_historico_powerbi[competencia] < CompAtual
			    )
			VAR Atual = SELECTEDVALUE(insights_historico_powerbi[servidores_plano_ativo])
			VAR Anterior = 
			    CALCULATE(
			        MAX(insights_historico_powerbi[servidores_plano_ativo]),
			        ALL(insights_historico_powerbi),
			        insights_historico_powerbi[competencia] = CompAnterior
			    )
			VAR Dif = IF(ISBLANK(CompAnterior), 0, Atual - Anterior)
			RETURN
			SWITCH(
			    TRUE(),
			    Dif > 0, "#16A34A", -- Verde
			    Dif < 0, "#DC2626", -- Vermelho
			    "#64748B"           -- Cinza para estabilidade
			)
			
			```
		lineageTag: 4bc9e165-0a09-4261-a3f9-bb55946b5a8a

	measure Card1_Servidores_Ativos = ```
			
			VAR CompAtual = SELECTEDVALUE(insights_historico_powerbi[competencia])
			VAR CompAnterior = 
			    CALCULATE(
			        MAX(insights_historico_powerbi[competencia]),
			        ALL(insights_historico_powerbi),
			        insights_historico_powerbi[competencia] < CompAtual
			    )
			VAR ValorNum = SELECTEDVALUE(insights_historico_powerbi[servidores_plano_ativo])
			VAR Anterior = 
			    CALCULATE(
			        MAX(insights_historico_powerbi[servidores_plano_ativo]),
			        ALL(insights_historico_powerbi),
			        insights_historico_powerbi[competencia] = CompAnterior
			    )
			VAR Dif = IF(ISBLANK(CompAnterior), 0, ValorNum - Anterior)
			VAR ValorFormatado = FORMAT(ValorNum, "#,##0", "pt-BR")
			RETURN
			SWITCH(
			    TRUE(),
			    Dif > 0, "▲ " & ValorFormatado,
			    Dif < 0, "▼ " & ValorFormatado,
			    "— " & ValorFormatado
			)
			
			```
		lineageTag: d2e5c94c-b2a6-4fdd-87bd-8b78431d2574

	measure Card2_Variacao_MoM = ```
			
			VAR VarNum = SELECTEDVALUE(insights_historico_powerbi[variacao_mensal_mom_fmt])
			VAR VarFormatado = FORMAT(VarNum, "+0.00%;-0.00%;0.00%")
			RETURN
			SWITCH(
			    TRUE(),
			    VarNum > 0, "▲ " & VarFormatado,
			    VarNum < 0, "▼ " & VarFormatado,
			    "— " & VarFormatado
			)
			
			```
		lineageTag: d91d6e1a-28d2-46f4-a5cc-fb763919d89b

	measure Cor_Card2_Variacao_MoM = ```
			
			VAR VarNum = SELECTEDVALUE(insights_historico_powerbi[variacao_mensal_mom_fmt])
			RETURN
			SWITCH(
			    TRUE(),
			    VarNum > 0, "#16A34A",
			    VarNum < 0, "#DC2626",
			    "#64748B"
			)
			
			```
		lineageTag: c62ad046-feb0-4939-8233-70d60e112044

	measure Card3_Adesao_Teletrabalho = ```
			
			VAR CompAtual = SELECTEDVALUE(insights_historico_powerbi[competencia])
			VAR CompAnterior = 
			    CALCULATE(
			        MAX(insights_historico_powerbi[competencia]),
			        ALL(insights_historico_powerbi),
			        insights_historico_powerbi[competencia] < CompAtual
			    )
			VAR Atual = SELECTEDVALUE(insights_historico_powerbi[adesao_teletrabalho_fmt])
			VAR Anterior = 
			    CALCULATE(
			        MAX(insights_historico_powerbi[adesao_teletrabalho_fmt]),
			        ALL(insights_historico_powerbi),
			        insights_historico_powerbi[competencia] = CompAnterior
			    )
			VAR Dif = Atual - Anterior
			VAR ValorFormatado = FORMAT(Atual, "0.0%")
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(CompAnterior), "— " & ValorFormatado,
			    Dif > 0, "▲ " & ValorFormatado,
			    Dif < 0, "▼ " & ValorFormatado,
			    "— " & ValorFormatado
			)
			
			```
		lineageTag: bde7c4f8-d0d3-473e-9f62-02618b9a3bd6

	measure Cor_Card3_Adesao_Teletrabalho = ```
			
			VAR CompAtual = SELECTEDVALUE(insights_historico_powerbi[competencia])
			VAR CompAnterior = 
			    CALCULATE(
			        MAX(insights_historico_powerbi[competencia]),
			        ALL(insights_historico_powerbi),
			        insights_historico_powerbi[competencia] < CompAtual
			    )
			VAR Atual = SELECTEDVALUE(insights_historico_powerbi[adesao_teletrabalho_fmt])
			VAR Anterior = 
			    CALCULATE(
			        MAX(insights_historico_powerbi[adesao_teletrabalho_fmt]),
			        ALL(insights_historico_powerbi),
			        insights_historico_powerbi[competencia] = CompAnterior
			    )
			VAR Dif = Atual - Anterior
			RETURN
			SWITCH(
			    TRUE(),
			    ISBLANK(CompAnterior), "#64748B",
			    Dif > 0, "#16A34A",
			    Dif < 0, "#DC2626",
			    "#64748B"
			)
			
			```
		lineageTag: c9845a9e-72d6-484a-88a9-17ab47cd0279

	measure Texto_Ultima_Atualizacao = ```
			
