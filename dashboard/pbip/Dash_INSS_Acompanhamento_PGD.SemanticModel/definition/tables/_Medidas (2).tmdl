	measure 'Média Vínculos por Servidor' = ```
			
			VAR TotalDesignacoes = DISTINCTCOUNT('fato_designacoes'[id_designacao])
			VAR TotalServidores = DISTINCTCOUNT('fato_designacoes'[id_usuario])
			RETURN
			DIVIDE(TotalDesignacoes, TotalServidores, 0)
			
			```
