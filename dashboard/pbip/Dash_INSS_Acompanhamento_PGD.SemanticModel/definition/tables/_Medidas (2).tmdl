table '_Medidas (2)'
	lineageTag: 733f3efc-7e16-4f9b-ad73-24c50e111bba

	measure Designações =
			
			DISTINCTCOUNT('fato_designacoes'[id_designacao])
		formatString: 0
		lineageTag: 65d0874e-58d1-4bb2-b8e5-7889a96bed7b

	measure 'Designações por Mês' =
			
			DIVIDE(
			    [Total de Designações],
			    [Meses Observados]
			)
		formatString: 0.00
		lineageTag: b4be2eae-b3f2-44ad-b05e-f9a0e6147797

	measure 'Designações por Status' =
			
			CALCULATE(
			    DISTINCTCOUNT('fato_designacoes'[id_designacao]),
			    'fato_designacoes'[id_designacao] <> BLANK()
			)
		formatString: 0
		lineageTag: 7bd9ab8e-b897-4f38-b9c3-4aab85463ef2

	measure 'Média de Designações' =
			
			AVERAGEX(
			    VALUES('fato_designacoes'[competencia]),
			    [Designações]
			)
		lineageTag: 1b15661a-f301-4a4c-a40e-3de8028b5123

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Média de Designações por Mês' =
			
			AVERAGEX(
			    VALUES('fato_designacoes'[competencia]),
			    CALCULATE(
			        DISTINCTCOUNT(
			            'fato_designacoes'[id_designacao]
			        )
			    )
			)
		lineageTag: 3eb0f503-4bf2-4f1f-951f-4644851f098b

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Meses Observados' =
			
			DISTINCTCOUNT(
			    'fato_designacoes'[competencia]
			)
		formatString: 0
		lineageTag: 8b6f26e8-e258-4ccc-9672-0984b873c5e7

	measure 'Total de Designações' =
			
			DISTINCTCOUNT('fato_designacoes'[id_designacao])
		formatString: 0
		lineageTag: 33fe3015-40b5-4534-9d6c-5d7ab4a13c2d

	measure 'Matrículas Ativas' =
			
			COUNTROWS(
			    FILTER(
			        VALUES('fato_designacoes'[id_usuario]),
			        VAR UltimaCompetencia =
			            CALCULATE(
			                MAX('fato_designacoes'[competencia])
			            )
			        VAR UltimoStatus =
			            CALCULATE(
			                MAX('fato_designacoes'[status]),
			                'fato_designacoes'[competencia] = UltimaCompetencia
			            )
			        RETURN
			            UltimoStatus <> "Desligado"
			    )
			)
		formatString: 0
		lineageTag: cb9328b9-4b93-4626-8a4a-ce776bd64a90

	measure 'Média de Tempo de Designação' =
			
			AVERAGE(
			    Designacoes_Unicas[Tempo de Designação]
			)
		lineageTag: 2a05d1a8-d8b5-428f-b601-f851be41c2ce

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Média Dias Designação' = ```
			
			AVERAGEX(
			    'fato_designacoes',
			    VAR dt_ini = 'fato_designacoes'[dt_inicio_designacao]
			    VAR dt_fim = 'fato_designacoes'[dt_fim_designacao]
			    RETURN
			    IF(
			        NOT(ISBLANK(dt_ini)) && NOT(ISBLANK(dt_fim)) && dt_fim >= dt_ini,
			        DATEDIFF(dt_ini, dt_fim, DAY),
			        BLANK()
			    )
			)
			
			```
		lineageTag: 66a5c059-bb00-41f7-982b-cd5685c89e17

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Teletrabalho' = ```
			
			CALCULATE(
			    DISTINCTCOUNT('fato_designacoes'[id_designacao]), 
			    'fato_designacoes'[modalidade] IN {"Remoto", "Semipresencial"},
			    'fato_designacoes'[status] = "Designado"
			)
			
			
			```
		formatString: 0
		lineageTag: b139bc11-569f-4c54-8110-984bd9cf3df8

	measure 'Teletrabalho Usuarios' = ```
			
			CALCULATE(
			    DISTINCTCOUNT('fato_designacoes'[id_usuario]), 
