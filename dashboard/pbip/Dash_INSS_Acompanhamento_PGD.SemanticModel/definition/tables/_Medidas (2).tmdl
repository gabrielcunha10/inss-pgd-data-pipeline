	measure 'Média Servidores Lotação'
		lineageTag: 79ec3c09-c4a6-4090-9e73-deefc1d7684f

	measure 'Média de Servidores' = ```
			
			DIVIDE (
			    DISTINCTCOUNT('fato_designacoes'[id_usuario]), 
