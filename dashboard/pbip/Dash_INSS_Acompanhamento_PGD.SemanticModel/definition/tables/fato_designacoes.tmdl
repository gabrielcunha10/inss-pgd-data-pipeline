				    public_fato = Fonte{[Schema="public",Item="fato_designacoes"]}[Data],
				    #"Coluna Condicional Adicionada" = Table.AddColumn(public_fato, "Ordem Modalidade", each if [modalidade] = "Remoto" then 1 else if [modalidade] = "Semipresencial" then 2 else if [modalidade] = "Presencial" then 3 else null, Int64.Type),
