expression CaminhoAutomatico = ```
		let
		    // 1. Busca o conteúdo de C:\Users
		    ConteudoUsers = Folder.Contents("C:\Users\"),
		    
		    // 2. Mantém APENAS pastas (descarta arquivos como desktop.ini)
		    ApenasPastas = Table.SelectRows(ConteudoUsers, each ([Attributes]?[Kind]? = "Folder")),
		    
		    // 3. Remove pastas padrão de sistema
		    PastasFiltradas = Table.SelectRows(ApenasPastas, each 
		        ([Name] <> "Public" and 
		         [Name] <> "Público" and 
		         [Name] <> "Default" and 
		         [Name] <> "Default User" and 
		         [Name] <> "All Users")
		    ),
		    
		    // 4. Pega o nome do seu usuário real
		    NomeUsuario = PastasFiltradas{0}[Name],
		    
		    // 5. Monta o caminho dinâmico correto
		    CaminhoFinal = "C:\Users\" & NomeUsuario & "\Downloads\archive\dataset\processed\pgd_designacoes_inss_2023_2026.csv",
		    #"Colunas Removidas" = Table.RemoveColumns(CaminhoFinal,{"CaminhoAutomatico"})
		in
		    #"Colunas Removidas"
		```
