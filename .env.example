# Configuração de Conexão com o Banco de Dados PostgreSQL (Neon Tech)
DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-2.aws.neon.tech/neondb?sslmode=require

# Webhook do Power Automate para Atualização Automática do Power BI (opcional para execução local)
# POWER_AUTOMATE_WEBHOOK_URL=https://prod-xx.brazilsouth.logic.azure.com:443/workflows/...

# Chave da API do Google Gemini para Geração Automática de Insights Mensais (Google AI Studio)
GEMINI_API_KEY=sua_chave_aqui

# Chave Secreta para Anonimização LGPD (HMAC-SHA256) das Matrículas dos Servidores
HMAC_SECRET_KEY=sua_chave_secreta_aleatoria_aqui_para_lgpd